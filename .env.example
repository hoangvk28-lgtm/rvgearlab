# RV Gear Lab — environment template. Copy to .env.local and fill in.
# .env.local is gitignored. Never commit real values.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.rvgearlab.com

# --- Analytics (both are public IDs; both stay off until set, and only fire when NODE_ENV=production) ---
# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity project ID, e.g. abcd1234ef (clarity.microsoft.com -> Settings -> Overview)
NEXT_PUBLIC_CLARITY_ID=zbdc385kwg
# Google Search Console HTML-tag verification token (the content="..." value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# Full database access. Treat as a root credential.
SUPABASE_SERVICE_ROLE_KEY=

# --- IndexNow ---
# Generate a key for this site, set it here, and add a matching
# public/<key>.txt containing the same string. No fallback by design:
# without both, the daily cron submits nothing.
INDEXNOW_KEY=93cc4d00bcba4400ad7a916061dcef95

# --- Cron ---
# Shared secret guarding /api/cron/* routes.
CRON_SECRET=

# --- Session (legacy admin modules) ---
# Minimum 32 characters.
SESSION_SECRET=

# --- Amazon Creators / PA API (product sourcing scripts only, never shipped to the client) ---
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_MARKETPLACE=
AMAZON_PAAPI_TOKEN_ENDPOINT=
